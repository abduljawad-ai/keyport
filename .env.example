# ============================================================================
# COPY THIS FILE TO `.env` AND FILL IN THE VALUES (or run: cp .env.example .env)
#
# FRONTEND-ONLY environment variables.
# These are SAFE to expose to the browser. Never put secrets here and never
# prefix secret values with VITE_.
# ============================================================================

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional. When omitted, the app derives it as {VITE_SUPABASE_URL}/functions/v1
# VITE_SUPABASE_FUNCTIONS_URL=https://YOUR-PROJECT-REF.supabase.co/functions/v1

# ============================================================================
# EDGE FUNCTION SECRETS — configure these in Supabase, never in this file:
#
#   supabase secrets set MASTER_ENCRYPTION_KEY=<base64 32-byte key>
#   supabase secrets set MASTER_ENCRYPTION_KEY_ID=v1
#   supabase secrets set FRONTEND_ORIGIN=http://localhost:5173,https://keyport-ai.vercel.app
#   supabase secrets set ALLOW_LOCAL_PROVIDER_URLS=false
#
#   MASTER_ENCRYPTION_KEY     base64-encoded 32-byte key used to wrap per-user
#                             data keys (envelope encryption). Treat as critical
#                             infrastructure; losing it makes stored keys
#                             unrecoverable.
#   MASTER_ENCRYPTION_KEY_ID  version label for key rotation (e.g. "v1").
#   FRONTEND_ORIGIN           comma-separated list of allowed browser origins.
#                             CORS fails closed when this is unset.
#   ALLOW_LOCAL_PROVIDER_URLS "true" only for local development; allows
#                             http:// loopback base URLs for testing. Keep
#                             "false" in production.
#
#   SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
#   the Supabase Edge runtime — never copy the service role key to a browser.
# ============================================================================
