{
  "name": "keyport-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Secure BYOK AI chat: bring your own provider API keys, stored encrypted, used server-side only.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
